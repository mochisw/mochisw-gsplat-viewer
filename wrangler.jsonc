{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mochisw-gsplat-viewer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": false
}
